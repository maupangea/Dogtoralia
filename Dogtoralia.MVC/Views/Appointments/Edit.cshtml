@model Dogtoralia.MVC.ViewModels.AppointmentFormViewModel

@{
    ViewData["Title"] = "Editar cita";
}

<h1>Editar cita</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="ClinicId" class="form-label">Clínica</label>
                <select asp-for="ClinicId" asp-items="Model.ClinicOptions" class="form-select">
                    <option value="">-- Seleccionar clínica --</option>
                </select>
                <span asp-validation-for="ClinicId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PetId" class="form-label">Mascota</label>
                <select asp-for="PetId" asp-items="Model.PetOptions" class="form-select">
                    <option value="">-- Seleccionar mascota --</option>
                </select>
                <span asp-validation-for="PetId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VeterinarianId" class="form-label">Veterinario</label>
                <select asp-for="VeterinarianId" asp-items="Model.VeterinarianOptions" class="form-select">
                    <option value="">Sin asignar</option>
                </select>
                <span asp-validation-for="VeterinarianId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AppointmentDate" class="form-label">Fecha y hora</label>
                <input asp-for="AppointmentDate" type="datetime-local" class="form-control"
                       value="@Model.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Reason" class="form-label">Motivo</label>
                <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notas adicionales</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Estado</label>
                <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Guardar cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
