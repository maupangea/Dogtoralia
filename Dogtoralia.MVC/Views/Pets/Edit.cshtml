@model PetFormViewModel

@{
    ViewData["Title"] = "Editar Mascota";
}

<h1>Editar Mascota</h1>

<div class="card mb-4 border-primary">
    <div class="card-header bg-primary text-white">Propietario</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.OwnerName</dd>
            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.OwnerEmail</dd>
            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.OwnerPhone</dd>
        </dl>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PetOwnerId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label">Nombre</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Species" class="form-label">Especie</label>
                    <select asp-for="Species" asp-items="Model.SpeciesOptions" class="form-select"></select>
                    <span asp-validation-for="Species" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Breed" class="form-label">Raza</label>
                    <input asp-for="Breed" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DateOfBirth" class="form-label">Fecha de nacimiento</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notas</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Guardar cambios</button>
                <a asp-controller="PetOwners" asp-action="Details" asp-route-id="@Model.PetOwnerId" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
