@model ClinicsIndexViewModel

@{
    ViewData["Title"] = "Clínicas";
    var routeValues = new Dictionary<string, string?>();
    if (Model.SelectedSpecialityId.HasValue)
        routeValues["specialityId"] = Model.SelectedSpecialityId.Value.ToString();
    ViewBag.CurrentPage = Model.Clinics.PageIndex;
    ViewBag.TotalPages = Model.Clinics.TotalPages;
    ViewBag.RouteValues = routeValues;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Clínicas</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Nueva Clínica</a>
    }
</div>

<form method="get" asp-action="Index" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">Filtrar por Especialidad</label>
            <select name="specialityId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Todas las Especialidades --</option>
                @foreach (var s in Model.Specialities)
                {
                    <option value="@s.Id" selected="@(Model.SelectedSpecialityId == s.Id)">@s.Name</option>
                }
            </select>
        </div>
        @if (Model.SelectedSpecialityId.HasValue)
        {
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        }
    </div>
</form>

@if (!Model.Clinics.Any())
{
    <div class="alert alert-info">No se encontraron clínicas.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var clinic in Model.Clinics)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@clinic.Name</h5>
                        <span class="badge bg-primary mb-2">@clinic.SpecialityName</span>
                        <p class="card-text text-muted small">@clinic.Address</p>
                        <p class="card-text small"><i class="bi bi-telephone"></i> @clinic.Phone</p>
                        <p class="card-text small">@clinic.VeterinarianCount veterinario(s)</p>
                        @if (!string.IsNullOrEmpty(clinic.Description))
                        {
                            <p class="card-text small text-truncate">@clinic.Description</p>
                        }
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@clinic.Id" class="btn btn-sm btn-outline-info">Detalles</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@clinic.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@clinic.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_PaginationPartial")
}
