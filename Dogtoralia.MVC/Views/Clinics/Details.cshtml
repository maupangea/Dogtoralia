@model ClinicDetailsViewModel

@{
    ViewData["Title"] = Model.Clinic.Name;
}

<h1>@Model.Clinic.Name</h1>
<span class="badge bg-primary fs-6 mb-3">@Model.Clinic.SpecialityName</span>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">@Model.Clinic.Address</dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Clinic.Phone</dd>

            <dt class="col-sm-3">Correo electrónico</dt>
            <dd class="col-sm-9"><a href="mailto:@Model.Clinic.Email">@Model.Clinic.Email</a></dd>

            @if (!string.IsNullOrEmpty(Model.Clinic.Website))
            {
                <dt class="col-sm-3">Sitio web</dt>
                <dd class="col-sm-9"><a href="@Model.Clinic.Website" target="_blank">@Model.Clinic.Website</a></dd>
            }

            @if (!string.IsNullOrEmpty(Model.Clinic.Description))
            {
                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">@Model.Clinic.Description</dd>
            }

            <dt class="col-sm-3">Creado</dt>
            <dd class="col-sm-9">@Model.Clinic.CreatedAt.ToString("d MMM yyyy")</dd>
        </dl>
    </div>
</div>

<h4>Veterinarios (@Model.Veterinarians.Count)</h4>

@if (Model.Veterinarians.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Licencia</th>
                <th>Correo electrónico</th>
                <th>Teléfono</th>
                <th>Experiencia</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vet in Model.Veterinarians)
            {
                <tr>
                    <td>@vet.FullName</td>
                    <td><code>@vet.LicenseNumber</code></td>
                    <td>@vet.Email</td>
                    <td>@vet.Phone</td>
                    <td>@vet.YearsOfExperience año(s)</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No hay veterinarios registrados.</p>
}

<h4 class="mt-4">Citas (@Model.AppointmentCount)</h4>
<div class="d-flex gap-2 mb-3">
    <a asp-controller="Appointments" asp-action="Index" asp-route-clinicId="@Model.Clinic.Id"
       class="btn btn-outline-info btn-sm">Ver citas</a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Appointments" asp-action="Create" asp-route-clinicId="@Model.Clinic.Id"
           class="btn btn-outline-primary btn-sm">+ Nueva cita</a>
    }
</div>

<div class="mt-3 d-flex gap-2">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Clinic.Id" class="btn btn-warning">Editar</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
