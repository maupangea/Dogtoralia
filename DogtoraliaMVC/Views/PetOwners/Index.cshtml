@model IEnumerable<DogtoraliaMVC.Models.PetOwner>

@{
    ViewData["Title"] = "Propietarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Propietarios</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo propietario</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay propietarios registrados.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo electrónico</th>
                <th>Teléfono</th>
                <th>Mascotas</th>
                <th>Registrado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var owner in Model)
            {
                <tr>
                    <td>@owner.Name</td>
                    <td><a href="mailto:@owner.Email">@owner.Email</a></td>
                    <td>@owner.Phone</td>
                    <td>@owner.Pets.Count</td>
                    <td>@owner.CreatedAt.ToString("d MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@owner.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-action="Edit" asp-route-id="@owner.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@owner.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
