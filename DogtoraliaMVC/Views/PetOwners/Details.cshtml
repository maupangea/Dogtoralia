@model DogtoraliaMVC.ViewModels.PetOwnerDetailsViewModel

@{
    ViewData["Title"] = Model.Owner.Name;
}

<h1>@Model.Owner.Name</h1>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Correo electrónico</dt>
            <dd class="col-sm-9"><a href="mailto:@Model.Owner.Email">@Model.Owner.Email</a></dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Owner.Phone</dd>

            <dt class="col-sm-3">Registrado</dt>
            <dd class="col-sm-9">@Model.Owner.CreatedAt.ToString("d MMM yyyy")</dd>
        </dl>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mascotas (@Model.Pets.Count)</h2>
    <a asp-controller="Pets" asp-action="Create" asp-route-petOwnerId="@Model.Owner.Id" class="btn btn-primary">+ Nueva mascota</a>
</div>

@if (!Model.Pets.Any())
{
    <div class="alert alert-info">Este propietario no tiene mascotas registradas.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Especie</th>
                <th>Raza</th>
                <th>Edad</th>
                <th>Notas</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pet in Model.Pets)
            {
                <tr>
                    <td>@pet.Name</td>
                    <td>@pet.Species</td>
                    <td>@pet.Breed</td>
                    <td>@pet.Age año(s)</td>
                    <td>@(pet.Notes ?? "—")</td>
                    <td class="text-end">
                        <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-controller="Pets" asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-controller="Pets" asp-action="Delete" asp-route-id="@pet.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Owner.Id" class="btn btn-warning">Editar propietario</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
