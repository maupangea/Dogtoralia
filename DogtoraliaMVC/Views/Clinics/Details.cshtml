@model DogtoraliaMVC.Models.Clinic

@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>
<span class="badge bg-primary fs-6 mb-3">@Model.Speciality.Name</span>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Correo electrónico</dt>
            <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>

            @if (!string.IsNullOrEmpty(Model.Website))
            {
                <dt class="col-sm-3">Sitio web</dt>
                <dd class="col-sm-9"><a href="@Model.Website" target="_blank">@Model.Website</a></dd>
            }

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            }

            <dt class="col-sm-3">Creado</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("d MMM yyyy")</dd>
        </dl>
    </div>
</div>

<h4>Veterinarios (@Model.Veterinarians.Count)</h4>

@if (Model.Veterinarians.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Licencia</th>
                <th>Correo electrónico</th>
                <th>Teléfono</th>
                <th>Experiencia</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vet in Model.Veterinarians)
            {
                <tr>
                    <td>@vet.FullName</td>
                    <td><code>@vet.LicenseNumber</code></td>
                    <td>@vet.Email</td>
                    <td>@vet.Phone</td>
                    <td>@vet.YearsOfExperience año(s)</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No hay veterinarios registrados.</p>
}

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
