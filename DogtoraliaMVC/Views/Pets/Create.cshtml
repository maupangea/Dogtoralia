@model PetFormViewModel

@{
    ViewData["Title"] = "Nueva Mascota";
}

<h1>Nueva Mascota</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label">Nombre</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Species" class="form-label">Especie</label>
                    <select asp-for="Species" asp-items="Model.SpeciesOptions" class="form-select">
                        <option value="">-- Seleccionar especie --</option>
                    </select>
                    <span asp-validation-for="Species" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Breed" class="form-label">Raza</label>
                    <input asp-for="Breed" class="form-control" />
                    <span asp-validation-for="Breed" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DateOfBirth" class="form-label">Fecha de nacimiento</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="OwnerName" class="form-label">Nombre del propietario</label>
                <input asp-for="OwnerName" class="form-control" />
                <span asp-validation-for="OwnerName" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="OwnerEmail" class="form-label">Correo del propietario</label>
                    <input asp-for="OwnerEmail" class="form-control" />
                    <span asp-validation-for="OwnerEmail" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="OwnerPhone" class="form-label">Teléfono del propietario</label>
                    <input asp-for="OwnerPhone" class="form-control" />
                    <span asp-validation-for="OwnerPhone" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notas</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Crear</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
