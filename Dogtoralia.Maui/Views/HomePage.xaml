<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dogtoralia.Maui.Views.HomePage"
             Title="Dogtoralia">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            <Image Source="dogtoralia.png"
                   HeightRequest="200"
                   Aspect="AspectFit"
                   SemanticProperties.Description="Logotipo de Dogtoralia" />

            <Label Text="Bienvenido a Dogtoralia"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />

            <Label Text="Catálogo de servicios veterinarios. Usa el menú lateral para explorar clínicas, mascotas y veterinarios."
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
