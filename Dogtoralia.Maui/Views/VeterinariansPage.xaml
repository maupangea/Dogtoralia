<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:Dogtoralia.Shared.Dtos;assembly=Dogtoralia.Shared"
             xmlns:vm="clr-namespace:Dogtoralia.Maui.Core.ViewModels;assembly=Dogtoralia.Maui.Core"
             x:Class="Dogtoralia.Maui.Views.VeterinariansPage"
             x:DataType="vm:VeterinariansViewModel"
             Title="Veterinarios">

    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="Red"
               Padding="16,8" />

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Veterinarians}"
                            Margin="12">
                <CollectionView.EmptyView>
                    <Label Text="No hay veterinarios para mostrar."
                           HorizontalOptions="Center"
                           Margin="0,40,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:VeterinarianDto">
                        <Border Margin="0,6" Padding="12" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="18" />
                                <Label Text="{Binding ClinicName}" FontSize="13" TextColor="Gray" />
                                <Label Text="{Binding Email}" FontSize="13" />
                                <Button Text="Detalles"
                                        Clicked="OnDetailsClicked"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="Start"
                                        Margin="0,6,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
