<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:Dogtoralia.Shared.Dtos;assembly=Dogtoralia.Shared"
             xmlns:vm="clr-namespace:Dogtoralia.Maui.Core.ViewModels;assembly=Dogtoralia.Maui.Core"
             x:Class="Dogtoralia.Maui.Views.PetDetailPage"
             x:DataType="vm:PetDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10"
                             x:DataType="dtos:PetDto"
                             BindingContext="{Binding Pet, Source={RelativeSource AncestorType={x:Type vm:PetDetailViewModel}}}">
            <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Species}" FontSize="15" TextColor="Gray" />

            <Label Text="Raza" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding Breed}" />

            <Label Text="Edad" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding Age}" />

            <Label Text="Notas" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding Notes}" />

            <Label Text="Propietario" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding PetOwnerName}" />
            <Label Text="{Binding PetOwnerEmail}" FontSize="13" TextColor="Gray" />
            <Label Text="{Binding PetOwnerPhone}" FontSize="13" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
