<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:Dogtoralia.Shared.Dtos;assembly=Dogtoralia.Shared"
             xmlns:vm="clr-namespace:Dogtoralia.Maui.Core.ViewModels;assembly=Dogtoralia.Maui.Core"
             x:Class="Dogtoralia.Maui.Views.VeterinarianDetailPage"
             x:DataType="vm:VeterinarianDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10"
                             x:DataType="dtos:VeterinarianDto"
                             BindingContext="{Binding Veterinarian, Source={RelativeSource AncestorType={x:Type vm:VeterinarianDetailViewModel}}}">
            <Label Text="{Binding FullName}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding ClinicName}" FontSize="15" TextColor="Gray" />

            <Label Text="Número de licencia" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding LicenseNumber}" />

            <Label Text="Correo" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding Email}" />

            <Label Text="Teléfono" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding Phone}" />

            <Label Text="Años de experiencia" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding YearsOfExperience}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
