<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Dogtoralia.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Dogtoralia.Maui.Views"
    Title="Dogtoralia"
    FlyoutBehavior="Flyout">

    <FlyoutItem Title="Inicio">
        <ShellContent
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage" />
    </FlyoutItem>

    <FlyoutItem Title="Clínicas">
        <ShellContent
            ContentTemplate="{DataTemplate views:ClinicsPage}"
            Route="ClinicsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Mascotas">
        <ShellContent
            ContentTemplate="{DataTemplate views:PetsPage}"
            Route="PetsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Veterinarios">
        <ShellContent
            ContentTemplate="{DataTemplate views:VeterinariansPage}"
            Route="VeterinariansPage" />
    </FlyoutItem>

</Shell>
